+static void fl_refresh_costs(fluff_ctx_t *ctx, const fl_u32 *ll, const fl_u32 *d)
+{
+    fl_u32 i, total = FLUFF_NUM_LITLEN, dt = FLUFF_NUM_DIST;
+    for (i = 0; i < FLUFF_NUM_LITLEN; i++) total += ll[i];
+    for (i = 0; i < FLUFF_NUM_DIST; i++) dt += d[i];
+    for (i = 0; i < FLUFF_NUM_LITLEN; i++)
+        ctx->parse_ll_cost[i] = (fl_u16)(fl_log_q4(total) - fl_log_q4(ll[i] + 1));
+    for (i = 0; i < FLUFF_NUM_DIST; i++)
+        ctx->parse_d_cost[i] = (fl_u16)(fl_log_q4(dt) - fl_log_q4(d[i] + 1));
+}
